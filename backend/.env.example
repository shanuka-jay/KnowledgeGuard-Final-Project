# Database
# Recommended for final submission: MongoDB Atlas.
# Atlas -> Connect -> Drivers -> copy the mongodb+srv connection string.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/knowledgeguard?retryWrites=true&w=majority

# Local development alternative:
# MONGODB_URI=mongodb://127.0.0.1:27017/knowledgeguard

# Auth
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars_long

# Frontend / server
FRONTEND_URL=http://localhost:5173
PORT=5000
NODE_ENV=development

# ML service
ML_SERVICE_URL=http://localhost:8000

# Optional Gmail email service.
# Leave blank if you only use in-app notifications.
# If enabled, use a Gmail App Password, not your normal Gmail password.
GMAIL_USER=
GMAIL_PASS=

# Optional AI assistant.
# Leave blank if you do not want Groq AI responses.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Same non-default secret must be set on the backend and ML service in production.
ML_API_KEY=

# Profile photos
# No extra image service is required. The backend uses Multer + MongoDB GridFS,
# so uploaded profile pictures are stored in the same MongoDB/Atlas database.
